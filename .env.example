# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored — never commit real credentials.
# Every value below is optional; config/env.ts falls back to a working default.

# Which environment this run targets: production | staging | local
TEST_ENV=production

# Target host for both the API and E2E layers.
BASE_URL=https://automationexercise.com

# Password for the throwaway accounts the API lifecycle test creates/deletes.
# In a real project this comes from a CI secret, never from a committed file.
TEST_USER_PASSWORD=TestPass123!
